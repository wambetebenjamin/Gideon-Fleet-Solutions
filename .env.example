# Runtime: Node.js 24.x (see .nvmrc).
# Use your canonical production origin; update before deployment.
NEXT_PUBLIC_SITE_URL=https://gideonfleet.co.ke

# Google reCAPTCHA v3 and the visible v2 fallback. Only the secret is server-side.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_RECAPTCHA_V2_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Vercel KV REST credentials (either KV_REST_API_* or VERCEL_KV_REST_API_*).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# VERCEL_KV_REST_API_URL=
# VERCEL_KV_REST_API_TOKEN=

# Vercel Blob private uploads for driver and vehicle documents.
BLOB_READ_WRITE_TOKEN=

# Optional managed tracking-presence WebSocket endpoint. /api/ws is a 426 fallback only.
NEXT_PUBLIC_TRACKING_WS_URL=

# WhatsApp Cloud API operations notifications. WHATSAPP_TO is the ops recipient, not the support link.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=+254112272061
WHATSAPP_API_VERSION=v21.0

# SMTP delivery for customer reference emails and contact enquiries.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
OPS_EMAIL=
